#!/bin/bash

set -euo pipefail

# Check required commands
for cmd in maim xclip; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: $cmd not found. Please install it." >&2
        exit 1
    fi
done

# Configuration
SCREENSHOTS_DIR="${SCREENSHOTS_DIR:-$HOME/Pictures/screenshots}"
mkdir -p "$SCREENSHOTS_DIR"

# Function to take a screenshot
screenshot() {
    local mode="$1"
    local filename_prefix="$2"
    local filename
    local base
    base="$SCREENSHOTS_DIR/screenshot-$(date +'%Y%m%d-%H%M%S')-$filename_prefix"
    filename="${base}.png"
    # Avoid overwriting a file captured in the same second
    local n=1
    while [ -e "$filename" ]; do
        filename="${base}-${n}.png"
        n=$((n + 1))
    done

    # Capture into a temp file first: writing straight into a pipeline hid
    # maim's exit status and left an empty .png behind when the capture was
    # cancelled (e.g. Escape while selecting an area).
    local tmpfile
    tmpfile="$(mktemp --suffix=.png)"
    trap 'rm -f "$tmpfile"' RETURN

    # shellcheck disable=SC2086
    if ! maim --format=png $mode "$tmpfile"; then
        echo "Screenshot cancelled." >&2
        return 1
    fi

    if [ ! -s "$tmpfile" ]; then
        echo "Screenshot cancelled (empty capture)." >&2
        return 1
    fi

    mv -- "$tmpfile" "$filename"

    # Copy to clipboard (does not block the screenshot if it fails)
    if ! xclip -selection clipboard -t image/png -i "$filename" 2>/dev/null; then
        echo "Warning: could not copy the screenshot to the clipboard." >&2
    fi

    # Notify the user
    if command -v dunstify &>/dev/null; then
        dunstify -a "Screenshot" \
                 -i "$filename" \
                 -t 5000 \
                 "Screenshot Saved" \
                 "Saved to: $(basename "$filename")" \
                 -r 100
    fi

    echo "Screenshot saved: $filename"
}

# Show usage information
usage() {
    cat <<-EOF >&2
Usage: $0 <mode>

Take a screenshot and save it to $SCREENSHOTS_DIR
The screenshot is also copied to clipboard.

Modes:
  all       Capture entire screen
  window    Capture active window (requires xdotool)
  select    Interactively select area to capture

Environment Variables:
  SCREENSHOTS_DIR    Directory to save screenshots (default: ~/Pictures/screenshots)

Examples:
  $0 all             # Capture full screen
  $0 window          # Capture active window
  $0 select          # Select area with mouse

Keybindings (suggested for i3):
  bindsym Print exec --no-startup-id $0 all
  bindsym Shift+Print exec --no-startup-id $0 window
  bindsym Control+Print exec --no-startup-id $0 select
EOF
    exit 1
}

# Main script logic
if [ $# -eq 0 ]; then
    usage
fi

case "$1" in
    all)
        screenshot "" "all"
        ;;
    window)
        if command -v xdotool &>/dev/null; then
            screenshot "--window $(xdotool getactivewindow)" "current"
        else
            echo "Error: xdotool is required for window mode. Please install it." >&2
            exit 1
        fi
        ;;
    select)
        screenshot "--select" "selected"
        ;;
    help|--help|-h)
        usage
        ;;
    *)
        echo "Error: Unknown mode '$1'" >&2
        usage
        ;;
esac
