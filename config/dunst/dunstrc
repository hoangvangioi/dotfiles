[global]
    title = Dunst
    class = Dunst
    follow = mouse
    origin = bottom-center
    progress_bar = false
    vertical_alignment = center
    font = JetBrainsMono Nerd Font 10

    width = (110, 300)
    height = (0, 100)
    offset = (15, 15)
    gap_size = 8
    notification_limit = 5

    corner_radius = 10
    separator_height = 1
    padding = 16
    horizontal_padding = 24
    text_icon_padding = 16
    alignment = left
    frame_width = 1
    frame_color = "#44475a"
    separator_color = "#6272a4"

    min_icon_size = 24
    max_icon_size = 64
    icon_corner_radius = 10
    icon_path = /usr/share/icons/Papirus/24x24/panel/:/usr/share/icons/Papirus/24x24/status/
    icon_theme = Papirus
    enable_recursive_icon_lookup = true

    timeout = 3
    sort = true
    markup = full
    line_height = 0
    stack_duplicates = false
    hide_duplicate_count = true
    word_wrap = yes
    ellipsize = end
    show_indicators = yes
    idle_threshold = 120
    show_age_threshold = 60
    dmenu = /usr/bin/rofi -p dunst:
    browser = /usr/bin/firefox --new-tab

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 8

[urgency_normal]
    background = "#282a36"
    foreground = "#f8f8f2"
    timeout = 8

[urgency_critical]
    background = "#ff5555"
    foreground = "#282a36"
    frame_color = "#ff79c6"
    timeout = 0

[backlight]
    appname = "Backlight"
    highlight = "#ffb86c"

[music]
    appname = "Music"
    background = "#282a36"
    foreground = "#f8f8f2"
    highlight = "#50fa7b"

[volume]
    summary = "Volume*"
    highlight = "#bd93f9"

[battery]
    appname = "Battery"
    highlight = "#f1fa8c"
