#!/usr/bin/env bash
set -euo pipefail

# Current Theme
dir="$HOME/.config/rofi/themes"
theme='powermenu'

# CMDs
uptime="$(uptime -p | sed -e 's/up //g')"
host="$(cat /proc/sys/kernel/hostname)"

# Options
shutdown=' Shutdown'
reboot=' Reboot'
lock=' Lock'
suspend=' Suspend'
logout=' Logout'
yes=' Yes'
no=' No'

# Rofi CMD
rofi_cmd() {
	rofi -dmenu \
		-p "$host" \
		-mesg "Uptime: $uptime" \
		-theme ${dir}/${theme}.rasi
}

# Confirmation CMD
confirm_cmd() {
	rofi -theme-str 'window {location: center; anchor: center; fullscreen: false; width: 250px;}' \
		-theme-str 'mainbox {children: [ "message", "listview" ];}' \
		-theme-str 'listview {columns: 2; lines: 1;}' \
		-theme-str 'element-text {horizontal-align: 0.5;}' \
		-theme-str 'textbox {horizontal-align: 0.5;}' \
		-dmenu \
		-p 'Confirmation' \
		-mesg 'Are you Sure?' \
		-theme ${dir}/${theme}.rasi
}

# Ask for confirmation
confirm_exit() {
	echo -e "$yes\n$no" | confirm_cmd
}

# Pass variables to rofi dmenu
run_rofi() {
	echo -e "$lock\n$suspend\n$logout\n$reboot\n$shutdown" | rofi_cmd
}

# Execute Command
run_cmd() {
	local selected
	# rofi exits 1 when the user presses Escape; that must not kill the script
	selected="$(confirm_exit)" || exit 0
	if [[ "$selected" == "$yes" ]]; then
		if [[ $1 == '--shutdown' ]]; then
			systemctl poweroff
		elif [[ $1 == '--reboot' ]]; then
			systemctl reboot
		elif [[ $1 == '--suspend' ]]; then
			# mpc/amixer are not installed (and amixer is wrong on PipeWire)
			if command -v pactl >/dev/null 2>&1; then
				pactl set-sink-mute @DEFAULT_SINK@ 1 || true
			fi
			systemctl suspend
		elif [[ $1 == '--logout' ]]; then
			# DESKTOP_SESSION is not always set; XDG_CURRENT_DESKTOP is the fallback
			local session="${DESKTOP_SESSION:-${XDG_CURRENT_DESKTOP:-i3}}"
			session="${session,,}"
			if [[ "$session" == 'openbox' ]]; then
				openbox --exit
			elif [[ "$session" == 'bspwm' ]]; then
				bspc quit
			elif [[ "$session" == 'i3' ]]; then
				i3-msg exit
			elif [[ "$session" == 'plasma' ]]; then
				qdbus org.kde.ksmserver /KSMServer logout 0 0 0
			else
				# last resort: ask i3, then logind
				i3-msg exit 2>/dev/null || loginctl terminate-user "$USER"
			fi
		fi
	else
		exit 0
	fi
}

# Actions
chosen="$(run_rofi)" || exit 0
# Note: quote the patterns, otherwise the icons inside them are glob-expanded
case "${chosen}" in
    "$shutdown")
		run_cmd --shutdown
        ;;
    "$reboot")
		run_cmd --reboot
        ;;
    "$lock")
		# `lock` in command position could resolve to anything, use a path
		if [[ -x '/usr/local/bin/lock' ]]; then
			(sleep 0.3 && /usr/local/bin/lock) &
		elif [[ -x "$HOME/.local/bin/lock" ]]; then
			(sleep 0.3 && "$HOME/.local/bin/lock") &
		elif command -v i3lock >/dev/null 2>&1; then
			(sleep 0.3 && i3lock -c 21222c) &
		else
			notify-send "Lock" "No screen locker found (install i3lock-color)" 2>/dev/null || true
		fi
        ;;
    "$suspend")
		run_cmd --suspend
        ;;
    "$logout")
		run_cmd --logout
        ;;
esac
