# ============================================================
# Variables
# ============================================================

# Mod key (Windows key). Change to Mod1 for Alt.
set $mod Mod4

# ============================================================
# General settings
# ============================================================

# Font for window titles. Will also be used by the bar.
font pango:JetBrainsMono Nerd Font 10

# ============================================================
# Autostart
# ============================================================

# Compositor first (transparency and fading).
exec --no-startup-id picom --config $HOME/.config/picom/picom.conf -b

# Multi-monitor: enable the second external output if it is connected.
# exec --no-startup-id sh -c 'xrandr | grep -q "^HDMI-2 connected" && xrandr --output HDMI-2 --right-of HDMI-1 --auto || true'

# Bar and wallpaper (re-applied on i3 restart).
exec_always --no-startup-id $HOME/.config/polybar/launch.sh
exec_always --no-startup-id feh --no-fehbg --bg-scale $HOME/Pictures/wallpapers/dracula.png

# Notification daemon (must start before anything that sends notifications).
exec --no-startup-id dunst

# Battery low warning (only if a battery exists, so desktops stay quiet).
exec --no-startup-id sh -c 'upower -e | grep -q BAT && battery || true'

# Input method, color temperature, touchpad.
exec --no-startup-id fcitx5 -d
exec --no-startup-id gammastep
exec --no-startup-id touchpad-config

# Lock screen before suspend.
exec --no-startup-id xss-lock --transfer-sleep-lock -- lock

# Network tray applet.
exec --no-startup-id nm-applet

# ============================================================
# Keybindings — applications
# ============================================================

# Terminal.
bindsym $mod+Return exec --no-startup-id alacritty

# Kill focused window.
bindsym $mod+Shift+q kill

# Rofi launchers.
bindsym $mod+d exec --no-startup-id "rofi -show drun -modi run,drun,ssh,window -scroll-method 0 -terminal alacritty -kb-cancel Escape -theme ~/.config/rofi/themes/launcher.rasi -config ~/.config/rofi/config.rasi"
bindsym $mod+x exec --no-startup-id "~/.config/rofi/script/powermenu"
bindsym $mod+c exec --no-startup-id "~/.config/rofi/script/recorder"
bindsym $mod+z exec --no-startup-id "~/.config/rofi/script/bluetooth"
bindsym $mod+p exec --no-startup-id "~/.config/rofi/script/calendar"
bindsym $mod+o exec --no-startup-id "~/.config/rofi/script/web-search"
bindsym $mod+i exec --no-startup-id "~/.config/rofi/script/spotify"

# Toggle polybar visibility.
bindsym $mod+t exec --no-startup-id polybar-msg cmd toggle

# Screenshots.
bindsym Print exec --no-startup-id "screenshot all"
bindsym $mod+Print exec --no-startup-id "screenshot window"
bindsym Shift+Print exec --no-startup-id "screenshot select"

# Volume.
bindsym XF86AudioRaiseVolume exec --no-startup-id volume up 5
bindsym XF86AudioLowerVolume exec --no-startup-id volume down 5
bindsym XF86AudioMute exec --no-startup-id volume mute
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness.
bindsym XF86MonBrightnessUp exec --no-startup-id brightness increase
bindsym XF86MonBrightnessDown exec --no-startup-id brightness decrease
bindsym Ctrl+F7 exec --no-startup-id brightness-hdmi down
bindsym Ctrl+F8 exec --no-startup-id brightness-hdmi up

# Microphone (PipeWire).
bindsym Ctrl+F3 exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ 1 && dunstify -a "Microphone" "Microphone" "Microphone is muted" -r 100 -i /usr/local/bin/icons/mic-off.svg
bindsym Ctrl+F4 exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ 0 && dunstify -a "Microphone" "Microphone" "Microphone is unmuted" -r 100 -i /usr/local/bin/icons/mic.svg

# Lock the screen.
bindsym XF86ScreenSaver exec --no-startup-id lock

# Touchpad toggle.
bindsym XF86TouchpadToggle exec --no-startup-id toggle-touchpad

# ============================================================
# Keybindings — window management
# ============================================================

# Focus.
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move focused window.
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Split.
bindsym $mod+h split h
bindsym $mod+v split v

# Fullscreen.
bindsym $mod+f fullscreen toggle

# Layout.
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# Tiling / floating.
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

# Focus parent.
bindsym $mod+a focus parent

# Scratchpad.
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

# Workspace names
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace.
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# Move focused container to workspace.
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Reload / restart / exit.
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec --no-startup-id "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Toggle default gaps (8/3 ↔ 0/0).
bindsym $mod+Shift+g exec --no-startup-id i3-msg "gaps inner all toggle 8; gaps outer all toggle 3"

# ============================================================
# Modes
# ============================================================

mode "resize" {
    # Pressing left shrinks width, right grows width,
    # up shrinks height, down grows height.
    bindsym j resize shrink width 10 px or 10 ppt
    bindsym k resize grow height 10 px or 10 ppt
    bindsym l resize shrink height 10 px or 10 ppt
    bindsym semicolon resize grow width 10 px or 10 ppt

    # Same bindings with the arrow keys.
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # Back to normal: Enter, Escape or $mod+r.
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

# Enter resize mode.
bindsym $mod+r mode "resize"

# ============================================================
# Window rules
# ============================================================

# Dialogs & popups → floating.
for_window [window_type="dialog"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable

# Utility apps → floating.
for_window [class="Pavucontrol"] floating enable
for_window [class="Pavucontrol"] resize set 800 550
for_window [class="Nm-connection-editor"] floating enable
for_window [class="Blueman-manager"] floating enable
for_window [class="Lxappearance"] floating enable
for_window [class="Arandr"] floating enable
for_window [class="feh"] floating enable

# Firefox Picture-in-Picture → floating + sticky.
for_window [title="Picture-in-Picture"] floating enable
for_window [title="Picture-in-Picture"] sticky enable
for_window [title="Picture-in-Picture"] resize set 640 360

# Launch Firefox on workspace 5.
bindsym $mod+b workspace number $ws5; exec --no-startup-id firefox

# Use Mouse+$mod to drag/resize floating windows.
floating_modifier $mod

# Border style (1px, no title bar for tiled windows).
default_border pixel 1
default_floating_border pixel 1

# Focus / mouse behavior.
focus_follows_mouse yes
mouse_warping output
popup_during_fullscreen smart

# Pressing the current workspace key again returns to the previous workspace.
workspace_auto_back_and_forth yes

# Gaps & borders.
gaps inner 8
gaps outer 3
smart_gaps on
hide_edge_borders smart_no_gaps

# ============================================================
# Colors
# ============================================================

